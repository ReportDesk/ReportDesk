@page
@model ReportSystem.Pages.Report.MachineModel
@{
    ViewData["Title"] = Model.PageHeading;
}

<div class="container-body">
    <div class="row mb-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h4 class="fw-bold mb-1">@Model.PageHeading</h4>
            <small class="text-muted">@Model.PageDescription</small>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="row">
            <div class="col-12 col-md-10 col-lg-8 mx-auto">
                <div class="alert alert-success">@Model.SuccessMessage</div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <form id="reportForm" method="post">

                        <div id="formError" class="text-danger mb-2 d-none"></div>

                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Waktu</label>
                                <input type="text" class="form-control"
                                       value="@Model.CurrentTimeDisplay" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Pelapor<span class="text-danger">*</span></label>
                                <select id="inputName" name="name" class="form-select searchable-select"
                                        data-source="/api/report/reporters" data-placeholder="— Select reporter —" disabled></select>
                                <span id="errName" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Nama Mesin<span class="text-danger">*</span></label>

                                <div id="machineLoadError" class="alert alert-warning py-2 mb-2 d-none">
                                    Could not load machine list. Please refresh or contact support.
                                </div>

                                <select id="inputMachine" name="machineId" class="form-select searchable-select" disabled>
                                    <option value="">Loading machines...</option>
                                </select>
                                <span id="errMachine" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Kondisi Mesin<span class="text-danger">*</span></label>
                                <textarea id="inputDescription" name="description"
                                          class="form-control" rows="6"
                                          placeholder="Describe the machine issue in detail"></textarea>
                                <span id="errDescription" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Upload Foto (Optional)</label>
                                <input id="photoInput" type="file" class="form-control"
                                       accept=".jpg,.jpeg,.png" multiple />
                                <button id="openCameraBtn" type="button" class="btn btn-outline-primary btn-sm mt-2">
                                    Take Photo in App
                                </button>
                                <div id="photoStatus" class="form-text text-muted mt-1">Gallery photos need valid capture metadata. Use Take Photo in App for a fresh PNG photo.</div>
                                <div id="photoPreviewList" class="mt-2 row g-2"></div>
                            </div>

                            <div class="col-12 d-grid">
                                <button type="submit" id="submitBtn"
                                        class="btn btn-primary">
                                    Submit
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="machineCameraModal" tabindex="-1" aria-labelledby="machineCameraModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="machineCameraModalLabel">Take Machine Photo</h5>
            </div>
            <div class="modal-body">
                <video id="cameraVideo" class="w-100 rounded bg-dark" autoplay muted playsinline></video>
                <canvas id="cameraCanvas" class="d-none"></canvas>
                <p class="form-text mb-0 mt-2">The photo is validated using this camera session and the server upload time.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="capturePhotoBtn" type="button" class="btn btn-primary">Capture Photo</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="photoErrorModal" tabindex="-1" aria-labelledby="photoErrorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger" id="photoErrorModalLabel">Photo Could Not Be Accepted</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0">
                <p id="photoErrorMessage" class="mb-2"></p>
                <p class="text-muted small mb-0">Take a new photo in the app, or choose the original photo file from your device.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            // ── state ────────────────────────────────────────────────────────
            let uploadedPhotos = [];
            let activeUploadCount = 0;
            let cameraStream = null;
            let captureSessionToken = null;

            // ── element refs ─────────────────────────────────────────────────
            const photoInput      = document.getElementById("photoInput");
            const photoStatus     = document.getElementById("photoStatus");
            const photoPreviewList = document.getElementById("photoPreviewList");
            const submitBtn       = document.getElementById("submitBtn");
            const formError       = document.getElementById("formError");
            const inputMachine    = document.getElementById("inputMachine");
            const machineLoadError = document.getElementById("machineLoadError");
            const openCameraBtn = document.getElementById("openCameraBtn");
            const machineCameraModal = new bootstrap.Modal(document.getElementById("machineCameraModal"));
            const cameraModalElement = document.getElementById("machineCameraModal");
            const cameraVideo = document.getElementById("cameraVideo");
            const cameraCanvas = document.getElementById("cameraCanvas");
            const capturePhotoBtn = document.getElementById("capturePhotoBtn");
            const photoErrorModal = new bootstrap.Modal(document.getElementById("photoErrorModal"));
            const photoErrorMessage = document.getElementById("photoErrorMessage");

            // ── helpers ──────────────────────────────────────────────────────
            function setPhotoStatus(msg, type = "muted") {
                photoStatus.textContent = msg;
                photoStatus.className = `form-text text-${type} mt-1`;
            }

            function clearPendingSelection() {
                photoInput.value = "";
            }

            function updatePhotoStatus() {
                if (activeUploadCount > 0) {
                    const suffix = activeUploadCount === 1 ? "" : "s";
                    setPhotoStatus(`Uploading ${activeUploadCount} photo${suffix}…`, "muted");
                    return;
                }

                if (uploadedPhotos.length === 0) {
                    setPhotoStatus("");
                    return;
                }

                const suffix = uploadedPhotos.length === 1 ? "" : "s";
                const unverifiedCount = uploadedPhotos.filter(photo => photo.validationStatus === "unverified").length;
                if (unverifiedCount > 0) {
                    setPhotoStatus(`${uploadedPhotos.length} photo${suffix} ready. ${unverifiedCount} is unverified and is allowed only in development mode.`, "warning");
                    return;
                }

                setPhotoStatus(`${uploadedPhotos.length} photo${suffix} ready.`, "success");
            }

            function renderPhotoPreviews() {
                photoPreviewList.innerHTML = "";

                uploadedPhotos.forEach((photo) => {
                    const item = document.createElement("div");
                    item.className = "col-6 col-md-4";
                    item.innerHTML = `
                        <div class="position-relative border rounded p-2 h-100">
                            <img src="${photo.previewUrl}" alt="Preview"
                                 class="img-fluid rounded"
                                 style="max-height:160px; width:100%; object-fit:cover;" />
                            <button type="button"
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1"
                                    data-temp-key="${photo.tempKey}"
                                    title="Remove photo">
                                ✕
                            </button>
                        </div>`;
                    photoPreviewList.appendChild(item);
                });
            }

            function setFieldError(spanId, msg) {
                const el = document.getElementById(spanId);
                if (el) el.textContent = msg;
            }

            function clearErrors() {
                ["errName", "errMachine", "errDescription"]
                    .forEach(id => setFieldError(id, ""));
                formError.textContent = "";
                formError.classList.add("d-none");
            }

            function showFormError(msg) {
                formError.textContent = msg;
                formError.classList.remove("d-none");
            }

            function setSubmitState(disabled, text = "Submit") {
                submitBtn.disabled = disabled;
                submitBtn.textContent = text;
            }

            function showPhotoError(message) {
                photoErrorMessage.textContent = message;
                photoErrorModal.show();
            }

            async function readJsonSafe(response) {
                const text = await response.text();
                if (!text) return {};

                try {
                    return JSON.parse(text);
                } catch {
                    return {};
                }
            }

            function setMachinePlaceholder(text) {
                inputMachine.innerHTML = "";
                const option = document.createElement("option");
                option.value = "";
                option.textContent = text;
                    inputMachine.appendChild(option);
                    inputMachine.dispatchEvent(new Event("change"));
            }

            async function loadMachines() {
                setMachinePlaceholder("Loading machines...");
                inputMachine.disabled = true;
                machineLoadError.classList.add("d-none");

                try {
                    const res = await fetch("/api/report/machines");
                    const data = await readJsonSafe(res);

                    if (!res.ok || !Array.isArray(data)) {
                        throw new Error(data.message || "Machine list request failed.");
                    }

                    setMachinePlaceholder("— Select machine —");

                    for (const machine of data) {
                        const option = document.createElement("option");
                        option.value = machine.machineId;
                        option.textContent = machine.label;
                        inputMachine.appendChild(option);
                    }

                    inputMachine.disabled = false;
                    inputMachine.dispatchEvent(new Event("change"));
                } catch {
                    setMachinePlaceholder("Machine list unavailable");
                    inputMachine.disabled = true;
                    machineLoadError.classList.remove("d-none");
                }
            }

            async function uploadPhoto(file, captureToken = null) {
                const fd = new FormData();
                fd.append("file", file);
                fd.append("purpose", "machine-report");
                if (captureToken) fd.append("captureSessionToken", captureToken);

                try {
                    const res = await fetch("/api/upload/temp", { method: "POST", body: fd });
                    const data = await readJsonSafe(res);

                    if (!res.ok) {
                        const message = data.error || data.message || `Upload failed for ${file.name}.`;
                        setPhotoStatus(message, "danger");
                        showPhotoError(message);
                        return false;
                    }

                    uploadedPhotos.push({
                        tempKey: data.tempKey,
                        uploadOwnerToken: data.uploadOwnerToken,
                        previewUrl: data.previewUrl,
                        validationStatus: data.photoValidationStatus
                    });
                    renderPhotoPreviews();
                    return true;
                } catch {
                    setPhotoStatus(`Upload error for ${file.name}. Please try again.`, "danger");
                    return false;
                }
            }

            async function createCaptureSession() {
                const res = await fetch("/api/upload/capture-session", { method: "POST" });
                const data = await readJsonSafe(res);
                if (!res.ok || !data.token) {
                    throw new Error(data.error || "Could not start a camera capture session.");
                }

                return data.token;
            }

            function stopCamera() {
                cameraStream?.getTracks().forEach(track => track.stop());
                cameraStream = null;
                cameraVideo.srcObject = null;
                captureSessionToken = null;
            }

            // ── client-side validation ───────────────────────────────────────
            function validate() {
                clearErrors();
                let valid = true;

                const name        = document.getElementById("inputName").value.trim();
                const machineId   = document.getElementById("inputMachine").value;
                const description = document.getElementById("inputDescription").value.trim();

                if (!name)        { setFieldError("errName",        "Name is required.");        valid = false; }
                if (!machineId)   { setFieldError("errMachine",     "Please select a machine."); valid = false; }
                if (!description) { setFieldError("errDescription", "Description is required."); valid = false; }
                if (activeUploadCount > 0) {
                    showFormError("Please wait until the photo upload finishes before submitting.");
                    valid = false;
                }

                return valid;
            }

            // ── upload on file select ────────────────────────────────────────
            photoInput.addEventListener("change", async function () {
                const files = Array.from(this.files || []);
                if (files.length === 0) return;

                clearErrors();
                photoInput.disabled = true;
                activeUploadCount += files.length;
                updatePhotoStatus();
                setSubmitState(true, "Uploading photo…");

                for (const file of files) {
                    try {
                        await uploadPhoto(file);
                    } finally {
                        activeUploadCount -= 1;
                        updatePhotoStatus();
                    }
                }

                clearPendingSelection();
                photoInput.disabled = false;
                setSubmitState(false, "Submit");
            });

            openCameraBtn.addEventListener("click", async function () {
                if (!navigator.mediaDevices?.getUserMedia) {
                    setPhotoStatus("Camera capture is not supported by this browser. Upload the original photo instead.", "danger");
                    return;
                }

                openCameraBtn.disabled = true;
                try {
                    captureSessionToken = await createCaptureSession();
                    cameraStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: { ideal: "environment" } },
                        audio: false
                    });
                    cameraVideo.srcObject = cameraStream;
                    machineCameraModal.show();
                } catch (error) {
                    captureSessionToken = null;
                    setPhotoStatus(error.message || "Could not access the camera. Check camera permission and try again.", "danger");
                } finally {
                    openCameraBtn.disabled = false;
                }
            });

            capturePhotoBtn.addEventListener("click", async function () {
                if (!captureSessionToken || !cameraVideo.videoWidth || !cameraVideo.videoHeight) return;

                capturePhotoBtn.disabled = true;
                photoInput.disabled = true;
                activeUploadCount += 1;
                updatePhotoStatus();
                setSubmitState(true, "Uploading photo…");

                try {
                    cameraCanvas.width = cameraVideo.videoWidth;
                    cameraCanvas.height = cameraVideo.videoHeight;
                    cameraCanvas.getContext("2d").drawImage(cameraVideo, 0, 0);
                    const photoBlob = await new Promise(resolve => cameraCanvas.toBlob(resolve, "image/png"));

                    if (!photoBlob) throw new Error("Could not capture the photo. Please try again.");

                    const photoFile = new File([photoBlob], "machine-capture.png", { type: "image/png" });
                    const uploaded = await uploadPhoto(photoFile, captureSessionToken);
                    if (uploaded) machineCameraModal.hide();
                } catch (error) {
                    setPhotoStatus(error.message || "Could not capture the photo. Please try again.", "danger");
                } finally {
                    activeUploadCount -= 1;
                    updatePhotoStatus();
                    photoInput.disabled = false;
                    capturePhotoBtn.disabled = false;
                    setSubmitState(false, "Submit");
                }
            });

            cameraModalElement.addEventListener("hidden.bs.modal", stopCamera);

            // ── remove photo ─────────────────────────────────────────────────
            photoPreviewList.addEventListener("click", async function (e) {
                const removeButton = e.target.closest("button[data-temp-key]");
                if (!removeButton) return;

                const tempKey = removeButton.dataset.tempKey;
                const photo = uploadedPhotos.find(x => x.tempKey === tempKey);
                if (!photo) return;

                removeButton.disabled = true;
                await deleteTempKey(photo);
                uploadedPhotos = uploadedPhotos.filter(x => x.tempKey !== tempKey);
                renderPhotoPreviews();
                updatePhotoStatus();
            });

            // ── delete helper ────────────────────────────────────────────────
            async function deleteTempKey(photo) {
                if (!photo?.tempKey || !photo?.uploadOwnerToken) return;

                try {
                    await fetch("/api/upload/temp", {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            tempKey: photo.tempKey,
                            uploadOwnerToken: photo.uploadOwnerToken
                        })
                    });
                } catch {
                    // Best-effort; TempFileCleanupService handles stragglers
                }
            }

            // ── form submit ──────────────────────────────────────────────────
            document.getElementById("reportForm").addEventListener("submit", async function (e) {
                e.preventDefault();

                if (!validate()) return;

                setSubmitState(true, "Submitting…");

                const fd = new FormData(this);
                fd.append("ReportType", "Machine");

                for (const photo of uploadedPhotos) {
                    fd.append("photoTempKeys", photo.tempKey);
                    fd.append("photoUploadOwnerTokens", photo.uploadOwnerToken);
                }

                try {
                    const res = await fetch("/api/report/submit", { method: "POST", body: fd });
                    const data = await readJsonSafe(res);

                    if (res.ok) {
                        if (data.reportId) {
                            window.location.href = `/Success?reportId=${encodeURIComponent(data.reportId)}`;
                            return;
                        }

                        showFormError("Report submitted, but the submitted report data could not be loaded.");
                        setSubmitState(false, "Submit");
                    } else {
                        const message = data.message || data.error || "Submission failed. Please check your inputs.";
                        showFormError(message);
                        setSubmitState(false, "Submit");
                    }
                } catch {
                    showFormError("An unexpected error occurred. Please try again.");
                    setSubmitState(false, "Submit");
                }
            });

            loadMachines();
        })();
    </script>
}

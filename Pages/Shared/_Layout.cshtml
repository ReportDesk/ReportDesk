@using System.Security.Claims
@using System.Text.Json
@using ReportSystem.Controllers.API
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReportSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ReportSystem.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .profile-circle {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #343a40;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            cursor: pointer;
            border: none;
        }

            .profile-circle:hover {
                background-color: #23272b;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid px-4">
                @{
                    string homeLink = Url.Page("/Index");

                    if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("Admin") || User.IsInRole("Machine"))
                        {
                            homeLink = Url.Page("/Admin/Main");
                        }
                        else if (User.IsInRole("Nearmiss"))
                        {
                            homeLink = Url.Page("/Admin/ReportList", new { ReportId = "Nearmiss" });
                        }
                        else if (User.IsInRole("Suggestion"))
                        {
                            homeLink = Url.Page("/Admin/ReportList", new { ReportId = "Suggestion" });
                        }
                        else if (User.IsInRole("Kaizen"))
                        {
                            homeLink = Url.Page("/Admin/ReportList", new { ReportId = "Kaizen" });
                        }
                    }
                }
                <a class="navbar-brand" href="@homeLink">Report Desk</a>
                <div class="ms-auto">

                    @if (HttpContextAccessor.HttpContext!.Session.GetString("UserId") != null)
                    {
                        <div class="dropdown">
                            <button class="btn d-flex align-items-center gap-2 dropdown-toggle"
                                    style="background: none; border: none;"
                                    id="profileDropdown"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <!-- Profile Icon -->
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="34"
                                     height="34"
                                     fill="currentColor"
                                     class="bi bi-person-circle text-dark"
                                     viewBox="0 0 16 16">
                                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                                    <path fill-rule="evenodd"
                                          d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z" />
                                </svg>

                                <!-- Username -->
                                <span class="text-dark fw-medium">
                                    @HttpContextAccessor.HttpContext!.Session.GetString("Username")
                                </span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end"
                                aria-labelledby="profileDropdown">

                                <li>
                                    <button class="dropdown-item"
                                            data-bs-toggle="modal"
                                            data-bs-target="#changePasswordModal">
                                        Change Password
                                    </button>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <button class="dropdown-item text-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#logoutModal">
                                        Logout
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-dark btn-sm" asp-area="" asp-page="/Login">Login</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" id="logoutModalLabel">Ready to Leave?</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Select "Logout" below if you are ready to end your current session.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <form method="post" asp-page="/Logout" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" id="changePasswordModalLabel">Change Password</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pb-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="oldPassword">Old Password</label>
                        <div class="input-group">
                            <input type="password"
                                   class="form-control"
                                   id="oldPassword"
                                   placeholder="Old Password" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePassword('oldPassword', this)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                </svg>
                            </button>
                        </div>
                        <div class="text-danger small mt-1" id="oldPasswordError"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold" for="newPassword">New Password</label>
                        <div class="input-group">
                            <input type="password"
                                   class="form-control"
                                   id="newPassword"
                                   placeholder="New password" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePassword('newPassword', this)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                </svg>
                            </button>
                        </div>
                        <div class="text-danger small mt-1" id="newPasswordError"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold" for="confirmPassword">Confirm Password</label>
                        <div class="input-group">
                            <input type="password"
                                   class="form-control"
                                   id="confirmPassword"
                                   placeholder="Confirm password" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePassword('confirmPassword', this)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                </svg>
                            </button>
                        </div>
                        <div class="text-danger small mt-1" id="confirmPasswordError"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning btn-sm" onclick="changePassword()">Change Password</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.bootstrap5.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>

        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';

            // Swap eye / eye-slash icon
            btn.innerHTML = isPassword
                ? `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-slash" viewBox="0 0 16 16">
                       <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/>
                       <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299l.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                       <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709z"/>
                       <path fill-rule="evenodd" d="M13.646 14.354l-12-12 .708-.708 12 12-.708.708z"/>
                   </svg>`
                : `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                       <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                       <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                   </svg>`;
        }

        function clearErrors() {
            $("#oldPasswordError").text("");
            $("#newPasswordError").text("");
            $("#confirmPasswordError").text("");

            $("#oldPassword").removeClass("is-invalid");
            $("#newPassword").removeClass("is-invalid");
            $("#confirmPassword").removeClass("is-invalid");
        }

        function showError(inputId, errorId, message) {
            $("#" + inputId).addClass("is-invalid");
            $("#" + errorId).text(message);
        }

        function changePassword() {

            clearErrors();

            var oldPassword = $("#oldPassword").val();
            var newPassword = $("#newPassword").val();
            var confirmPassword = $("#confirmPassword").val();

            let hasError = false;

            if (!oldPassword) {
                showError("oldPassword", "oldPasswordError", "Old password is required.");
                hasError = true;
            }

            if (!newPassword) {
                showError("newPassword", "newPasswordError", "New password is required.");
                hasError = true;
            }

            if (!confirmPassword) {
                showError("confirmPassword", "confirmPasswordError", "Confirm password is required.");
                hasError = true;
            }

            if (hasError)
                return;

            if (oldPassword === newPassword) {
                showError("newPassword", "newPasswordError",
                    "New password cannot be the same as old password.");
                return;
            }

            if (newPassword.length < 6) {
                showError("newPassword", "newPasswordError",
                    "Password must be at least 6 characters long.");
                return;
            }

            if (newPassword !== confirmPassword) {
                showError("confirmPassword", "confirmPasswordError",
                    "Passwords do not match.");
                return;
            }

            $.ajax({
                url: '/api/user/ChangePassword',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    oldPassword: oldPassword,
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                }),
                success: function (res) {
                    alert(res.message || "Password changed successfully.");

                    const modalEl = document.getElementById('changePasswordModal');
                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal'))?.hide();

                    $('#oldPassword').val('');
                    $('#newPassword').val('');
                    $('#confirmPassword').val('');

                    clearErrors();

                    window.location.href = res.redirect || '/Login';
                },
                error: function (xhr) {
                    var message = xhr.responseJSON?.message || "An error occurred.";

                    // Route the error to the correct field based on the message
                    if (message.toLowerCase().includes("new password")) {
                        showError("newPassword", "newPasswordError", message);
                    } else if (message.toLowerCase().includes("confirm") || message.toLowerCase().includes("confirmation")) {
                        showError("confirmPassword", "confirmPasswordError", message);
                    } else {
                        showError("oldPassword", "oldPasswordError", message);
                    }
                }
            });
        }
    </script>
</body>
</html>
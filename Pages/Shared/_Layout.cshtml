@using System.Security.Claims
@using System.Text.Json
@using ReportSystem.Controllers.API
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReportSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ReportSystem.styles.css" asp-append-version="true" />
    <style>
        .profile-circle {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #343a40;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            cursor: pointer;
            border: none;
        }

            .profile-circle:hover {
                background-color: #23272b;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Report Desk</a>
                <div class="ms-auto">

                    @if (HttpContextAccessor.HttpContext!.Session.GetString("UserId") != null)
                    {
                        <div class="dropdown">
                            <button class="btn d-flex align-items-center gap-2 dropdown-toggle"
                                    style="background: none; border: none;"
                                    id="profileDropdown"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <!-- Profile Icon -->
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="34"
                                     height="34"
                                     fill="currentColor"
                                     class="bi bi-person-circle text-dark"
                                     viewBox="0 0 16 16">
                                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                                    <path fill-rule="evenodd"
                                          d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z" />
                                </svg>

                                <!-- Username -->
                                <span class="text-dark fw-medium">
                                    @HttpContextAccessor.HttpContext!.Session.GetString("Username")
                                </span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end"
                                aria-labelledby="profileDropdown">

                                <li>
                                    <button class="dropdown-item"
                                            data-bs-toggle="modal"
                                            data-bs-target="#changePasswordModal">
                                        Change Password
                                    </button>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <button class="dropdown-item text-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#logoutModal">
                                        Logout
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-dark btn-sm" asp-area="" asp-page="/Login">Login</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" id="logoutModalLabel">Ready to Leave?</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Select "Logout" below if you are ready to end your current session.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <form method="post" asp-page="/Logout" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" id="changePasswordModalLabel">Change Password</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pb-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="oldPassword">Old Password</label>
                        <input type="password"
                               class="form-control"
                               id="oldPassword"
                               placeholder="Old Password" />
                        <div class="text-danger small mt-1" id="oldPasswordError"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold" for="newPassword">New Password</label>
                        <input type="password"
                               class="form-control"
                               id="newPassword"
                               placeholder="New password" />
                        <div class="text-danger small mt-1" id="newPasswordError"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold" for="confirmPassword">Confirm Password</label>
                        <input type="password"
                               class="form-control"
                               id="confirmPassword"
                               placeholder="Confirm password" />
                        <div class="text-danger small mt-1" id="confirmPasswordError"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning btn-sm" onclick="changePassword()">Change Password</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
            function clearErrors() {
            $("#oldPasswordError").text("");
            $("#newPasswordError").text("");
            $("#confirmPasswordError").text("");

            $("#oldPassword").removeClass("is-invalid");
            $("#newPassword").removeClass("is-invalid");
            $("#confirmPassword").removeClass("is-invalid");
        }

        function showError(inputId, errorId, message) {
            $("#" + inputId).addClass("is-invalid");
            $("#" + errorId).text(message);
        }

        function changePassword() {

            clearErrors();

            var oldPassword = $("#oldPassword").val();
            var newPassword = $("#newPassword").val();
            var confirmPassword = $("#confirmPassword").val();

            let hasError = false;

            if (!oldPassword) {
                showError("oldPassword", "oldPasswordError", "Old password is required.");
                hasError = true;
            }

            if (!newPassword) {
                showError("newPassword", "newPasswordError", "New password is required.");
                hasError = true;
            }

            if (!confirmPassword) {
                showError("confirmPassword", "confirmPasswordError", "Confirm password is required.");
                hasError = true;
            }

            if (hasError)
                return;

            if (oldPassword === newPassword) {
                showError("newPassword", "newPasswordError",
                    "New password cannot be the same as old password.");
                return;
            }

            if (newPassword.length < 6) {
                showError("newPassword", "newPasswordError",
                    "Password must be at least 6 characters long.");
                return;
            }

            if (newPassword !== confirmPassword) {
                showError("confirmPassword", "confirmPasswordError",
                    "Passwords do not match.");
                return;
            }

            $.ajax({
                url: '/api/user/ChangePassword',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    oldPassword: oldPassword,
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                }),
                success: function (res) {
                    alert(res.message || "Password changed successfully.");

                    const modalEl = document.getElementById('changePasswordModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);

                    $('#changePasswordModal').modal.hide();

                    $('#oldPassword').val('');
                    $('#newPassword').val('');
                    $('#confirmPassword').val('');

                    clearErrors();

                    window.location.href = res.redirect || '/Login';
                },
                error: function (xhr) {
                    showError(
                        "oldPassword",
                        "oldPasswordError",
                        xhr.responseJSON?.message || "An error occurred."
                    );
                }
            });
        }
    </script>
</body>
</html>
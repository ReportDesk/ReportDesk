@page
@model ReportSystem.Pages.ReportFormModel
@{
    ViewData["Title"] = "Report Form";
}

<div class="container-body">
    <div class="row mb-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h4 class="fw-bold mb-1">Report Form</h4>
            <small class="text-muted">Fill in the report details below.</small>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <form method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="reportTitle" class="form-label fw-semibold">Title</label>
                            <input  id="reportTitle"
                                    name="Title"
                                    type="text"
                                    class="form-control"
                                    placeholder="Enter Report Title"/>
                        </div>

                        <div class="mb-3">
                            <label for="reportTime" class="form-label fw-semibold">Time</label>
                            <input id="reportTime"
                                   type="text"
                                   class="form-control"
                                   value="@Model.CurrentTimeDisplay"
                                   readonly />
                            <div class="form-text">Automated timestamp.</div>
                        </div>

                        <div class="mb-3">
                            <label for="reportName" class="form-label fw-semibold">Name</label>
                            <input id="reportName"
                                   name="Name"
                                   type="text"
                                   class="form-control"
                                   placeholder="Enter your name" />
                        </div>

                        @* Machine Only  *@

                        <div class="mb-3">
                            <label for="reportArea" class="form-label fw-semibold">Machine Name</label>
                            <select class="form-control" id="selector">
                                <option value="machine1" selected>Machine 1</option>
                                <option value="machine2">Machine 2</option>
                                <option value="machine3">Machine 3</option>
                                <option value="machine4">Machine 4</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="reportArea" class="form-label fw-semibold">Area</label>
                            <input id="reportArea"
                                   name="Area"
                                   type="text"
                                   class="form-control"
                                   placeholder="Enter Area" />
                        </div>

                        <div class="mb-3">
                            <label for="reportDescription" class="form-label fw-semibold">Description</label>
                            <textarea id="reportDescription"
                                      name="Description"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Write the report details"></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="reportPhoto" class="form-label fw-semibold">Upload Photo (Optional)</label>
                            <input id="reportPhoto"
                                   name="Photo"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />
                            <div class="form-text">Optional image upload.</div>
                        </div>

                        @* Kaizen Only *@

                        <div class="mb-3">
                            <label for="reportDescription" class="form-label fw-semibold">Description</label>
                            <textarea id="reportDescription"
                                      name="Description"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Write the report details"></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="reportPhoto" class="form-label fw-semibold">Foto Sesudah</label>
                            <input id="reportPhoto"
                                   name="Photo"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />
                            <div class="form-text"> Upload Image </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

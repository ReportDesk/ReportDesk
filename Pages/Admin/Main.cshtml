@page
@model ReportSystem.Pages.Admin.MainModel
@{
    ViewData["Title"] = "Main";
}

<div class="container-body">
    <div class="row mb-2">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <h5 class="fw-bold">Main Menu</h5>
        </div>
    </div>

    <div class="row">

        <!-- Machine Report -->
        <div class="col-lg-4 mb-4">
            <a href="/Admin/ReportList?ReportType=Machine" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                <img class="card-img-top rounded-top"
                     src="~/asset/Machine.svg"
                     alt="Machine Report"
                     style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                    <h5 class="card-title fw-bold text-dark mb-1">Machine Report List</h5>
                    <small class="text-muted">Menindaklanjuti mesin atau peralatan yang rusak</small>
                </div>
            </a>
        </div>

        @if (Model.UserRole == "1" || Model.UserRole?.ToLower() == "admin")
        {
            <!-- Near-Miss Report -->
            <div class="col-lg-4 mb-4">
                <a href="/Admin/ReportList?ReportType=NearMiss" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                    <img class="card-img-top rounded-top"
                         src="~/asset/Nearmiss.svg"
                         alt="Near-Miss Report"
                         style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                    <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                        <h5 class="card-title fw-bold text-dark mb-1">Near-Miss Report List</h5>
                        <small class="text-muted">Menindaklanjuti temuan kondisi yang berpotensi bahaya</small>
                    </div>
                </a>
            </div>

            <!-- Suggestion -->
            <div class="col-lg-4 mb-4">
                <a href="/Admin/ReportList?ReportType=Suggestion" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                    <img class="card-img-top rounded-top"
                         src="~/asset/Suggestion.svg"
                         alt="Suggestion"
                         style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                    <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                        <h5 class="card-title fw-bold text-dark mb-1">Suggestion List</h5>
                        <small class="text-muted">Menindaklanjuti ide perbaikan di segala bidang</small>
                    </div>
                </a>
            </div>

            <!-- Kaizen Report -->
            <div class="col-lg-4 mb-4">
                <a href="/Admin/ReportList?ReportType=Kaizen" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                    <img class="card-img-top rounded-top"
                         src="~/asset/Kaizen.svg"
                         alt="Kaizen Report"
                         style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                    <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                        <h5 class="card-title fw-bold text-dark mb-1">Kaizen Report List</h5>
                        <small class="text-muted">Menindaklanjuti laporan kaizen</small>
                    </div>
                </a>
            </div>

            <!-- Master User (Admin Only) -->
            <div class="col-lg-4 mb-4">
                <a href="/Admin/MasterUser" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                    <img class="card-img-top rounded-top"
                         src="~/asset/Admin.svg"
                         alt="Master User"
                         style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                    <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                        <h5 class="card-title fw-bold text-dark mb-1">User Management</h5>
                        <small class="text-muted">Kelola data pengguna sistem</small>
                    </div>
                </a>
            </div>
        }

        <!-- Master Machine -->
        <div class="col-lg-4 mb-4">
            <a href="/Admin/MasterMachine" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                <img class="card-img-top rounded-top"
                     src="~/asset/Machine_List.svg"
                     alt="Master Machine"
                     style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                    <h5 class="card-title fw-bold text-dark mb-1">Machine Management</h5>
                    <small class="text-muted">Kelola data mesin dan peralatan</small>
                </div>
            </a>
        </div>

        @if (Model.UserRole == "1" || Model.UserRole?.ToLower() == "admin")
        {
            <div class="col-lg-4 mb-4">
                <a href="/Admin/MasterReporter" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                    <img class="card-img-top rounded-top" src="~/asset/Admin.svg" alt="Master Data" style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                    <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                        <h5 class="card-title fw-bold text-dark mb-1">Reporter Management</h5>
                        <small class="text-muted">Kelola nama pelapor laporan</small>
                    </div>
                </a>
            </div>
            <div class="col-lg-4 mb-4">
                <a href="/Admin/MasterArea" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                    <img class="card-img-top rounded-top" src="~/asset/Admin.svg" alt="Master Area" style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                    <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                        <h5 class="card-title fw-bold text-dark mb-1">Area Management</h5>
                        <small class="text-muted">Kelola area laporan</small>
                    </div>
                </a>
            </div>
        }

    </div>
</div>

@page
@model ReportSystem.Pages.Admin.MasterUserModel
@{
    ViewData["Title"] = "Master User";
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@functions {
    public void ConfigureAntiforgeryToken()
    {
        ViewData["RequestVerificationToken"] = Xsrf.GetAndStoreTokens(HttpContext).RequestToken;
    }
}
@{
    ConfigureAntiforgeryToken();
    @Html.AntiForgeryToken()
}

<div class="container-body">


    <!-- Header -->
    <div class="row mb-2">
        <div class="col-lg-6 col-md-6 col-sm-6">
            <h3>User Management</h3>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-6">
            <button type="button" class="btn btn-primary float-end"
                    data-bs-toggle="modal" data-bs-target="#modalAddUser">
                <i class="fas fa-plus me-1"></i> New User
            </button>
        </div>
    </div>

    <!-- Breadcrumb -->
    <div class="row mb-2">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="~/Admin/Main">Home</a></li>
                <li class="breadcrumb-item active">User Management</li>
            </ol>
        </div>
    </div>

    <!-- ── Notification Area ──────────────────────────────────── -->
    <div id="notifArea"></div>

    <!-- User Table -->
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table initDataTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 18%">Username</th>
                                    <th style="width: 20%">Name</th>
                                    <th style="width: 10%">Role</th>
                                    <th style="width: 12%">Email</th>
                                    <th style="width: 10%">Status</th>
                                    <th style="width: 18%">Last Update</th>
                                    <th style="width: 22%">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Users.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">No users found.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var u in Model.Users)
                                    {
                                        <tr>
                                            <td>@u.Username</td>
                                            <td>@u.Fullname</td>
                                            <td><span class="badge bg-secondary">@u.Role</span></td>
                                            <td>@u.Email</td>
                                            <td>
                                                <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">
                                                    @(u.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>
                                                @(u.UpdatedDate.HasValue
                                                                                        ? u.UpdatedDate.Value.ToString("dd MMM yyyy HH:mm")
                                                                                        : u.CreatedDate.ToString("dd MMM yyyy HH:mm"))
                                    </td>
                                    <td class="text-end" style="white-space: nowrap;">
                                        <button type="button" class="btn btn-warning btn-sm text-dark"
                                                onclick="openEditModal('@u.UserId')">
                                            Edit
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm"
                                                onclick="openResetModal('@u.Username')">
                                            Reset Password
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm"
                                                onclick="openDeleteModal(@u.UserId, '@u.Username')">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                                                                }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ── Modal: Edit User ──────────────────────────────────────── -->
<div class="modal fade" id="modalEditUser" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Edit User</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editUserId" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <input type="text" class="form-control" id="editFullname" placeholder="John Doe" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Username</label>
                    <input type="text" class="form-control" id="editUsername" disabled />
                    <div class="form-text">Username cannot be changed.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" class="form-control" id="editEmail" placeholder="john.doe@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Role</label>
                    <select class="form-select" id="editRole">
                        <option value="">Select role...</option>
                        <option value="Admin">Admin</option>
                        <option value="Machine">Machine</option>
                        <option value="Nearmiss">Nearmiss</option>
                        <option value="Suggestion">Suggestion</option>
                        <option value="Kaizen">Kaizen</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold d-block">Status</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="editIsActive" />
                        <label class="form-check-label fw-semibold" for="editIsActive">Active</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning text-dark" onclick="EditUser()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal: Add User ──────────────────────────────────────── -->
<div class="modal fade" id="modalAddUser" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Add New User</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <input type="text" class="form-control" id="addFullname" placeholder="John Doe" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Username</label>
                    <input type="text" class="form-control" id="addUsername" placeholder="john.doe" />
                    <div class="form-text">Lowercase letters, numbers, dots, underscores only.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" class="form-control" id="addEmail" placeholder="john.doe@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Role</label>
                    <select class="form-select" id="addRole">
                        <option value="">Select role...</option>
                        <option value="Admin">Admin</option>
                        <option value="Machine">Machine</option>
                        <option value="Nearmiss">Nearmiss</option>
                        <option value="Suggestion">Suggestion</option>
                        <option value="Kaizen">Kaizen</option>
                    </select>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="addIsActive" checked />
                    <label class="form-check-label fw-semibold" for="addIsActive">Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="AddUser()">Add User</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal: Reset Password ──────────────────────────────────── -->
<div class="modal fade" id="modalResetPass" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Reset Password</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to reset <strong id="resetUsernameLabel"></strong>'s password to the default?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="ResetPassword()">Reset</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal: Delete User ──────────────────────────────────────── -->
<div class="modal fade" id="modalDelete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Delete User</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong id="deleteUsernameLabel"></strong>? This cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="DeleteUser()">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        #notifArea .alert .btn-close {
            top: 50%;
            transform: translateY(-50%);
        }
    </style>
    <script>

        $(document).ready(function () {
            $('table.initDataTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                columnDefs: [{ orderable: false, targets: 6 }]
            });

            // ── Show any pending notification left from a previous action ──
            const pending = sessionStorage.getItem('pendingNotif');
            if (pending) {
                sessionStorage.removeItem('pendingNotif');
                try {
                    const { message, type } = JSON.parse(pending);
                    showNotif(message, type);
                } catch (_) { /* malformed entry, ignore */ }
            }
        });

        // ── State ─────────────────────────────────────────────────
        const users              = @Html.Raw(Json.Serialize(Model.Users));
        let currentResetUsername = null;
        let currentDeleteUserId  = null;
        let isSubmitting         = false;

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        // ── Notification helper ────────────────────────────────────
        function showNotif(message, type = 'success') {
            const area = document.getElementById('notifArea');
            const id   = 'notif_' + Date.now();

            area.innerHTML = `
                <div id="${id}" class="alert alert-${type} alert-dismissible py-2 fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;

            // Auto-dismiss after 5s
            setTimeout(() => {
                const el = document.getElementById(id);
                if (el) bootstrap.Alert.getOrCreateInstance(el).close();
            }, 5000);
        }

        // ── Queue a notification to appear after the next page reload ──
        function queueNotif(message, type = 'success') {
            sessionStorage.setItem('pendingNotif', JSON.stringify({ message, type }));
        }

        // ── Close modal, wait for backdrop, then run callback ─────
        function closeModalThen(modalId, callback) {
            const modalEl = document.getElementById(modalId);
            const modal   = bootstrap.Modal.getInstance(modalEl)
                         ?? bootstrap.Modal.getOrCreateInstance(modalEl);
            modalEl.addEventListener('hidden.bs.modal', callback, { once: true });
            modal.hide();
        }

        // ── AJAX wrapper ───────────────────────────────────────────
        function ajax(url, payload, modalId) {
            if (isSubmitting) return;
            isSubmitting = true;

            closeModalThen(modalId, () => {
                $.ajax({
                    url:         url,
                    type:        'POST',
                    contentType: 'application/json',
                    headers:     { 'RequestVerificationToken': getToken() },
                    data:        JSON.stringify(payload),
                    success: (res) => {
                        queueNotif(res.message || 'Operation successful.', 'success');
                        location.reload();
                    },
                    error: (xhr) => {
                        isSubmitting = false;
                        let msg = 'An error occurred.';
                        if (xhr.responseJSON?.message) {
                            msg = xhr.responseJSON.message;
                        } else if (xhr.status === 401 || xhr.status === 403) {
                            msg = 'Session expired. Please log in again.';
                            setTimeout(() => window.location.href = '/Login', 2000);
                        } else {
                            msg = `Server error (${xhr.status}).`;
                        }
                        showNotif(msg, 'danger');
                    }
                });
            });
        }

        // ── Add User ───────────────────────────────────────────────
        function AddUser() {
            const fullname = $('#addFullname').val().trim();
            const username = $('#addUsername').val().trim();
            const email    = $('#addEmail').val().trim();
            const role     = $('#addRole').val();
            const isActive = $('#addIsActive').is(':checked') ? '1' : '0';

            if (!fullname || !username || !email || !role) {
                showNotif('Please fill in all fields.', 'warning');
                return;
            }

            ajax('/api/user/AddEditUser', { userId: 0, fullname, username, email, role, isActive }, 'modalAddUser');
        }

        // Clear Add modal on close
        document.getElementById('modalAddUser').addEventListener('hidden.bs.modal', () => {
            $('#addFullname, #addUsername, #addEmail').val('');
            $('#addRole').val('');
            $('#addIsActive').prop('checked', true);
        });

        // ── Edit User ──────────────────────────────────────────────
        function openEditModal(userId) {
            const user = users.find(u => u.userId == parseInt(userId, 10));
            if (!user) return;

            document.getElementById('editUserId').value   = user.userId;
            document.getElementById('editFullname').value = user.fullname ?? '';
            document.getElementById('editUsername').value = user.username;
            document.getElementById('editEmail').value    = user.email ?? '';
            document.getElementById('editRole').value     = user.role;
            document.getElementById('editIsActive').checked = user.isActive;

            new bootstrap.Modal(document.getElementById('modalEditUser')).show();
        }

        function EditUser() {
            const userId   = document.getElementById('editUserId').value;
            const fullname = document.getElementById('editFullname').value.trim();
            const username = document.getElementById('editUsername').value.trim();
            const email    = document.getElementById('editEmail').value.trim();
            const role     = document.getElementById('editRole').value;
            const isActive = document.getElementById('editIsActive').checked ? '1' : '0';

            if (!fullname || !email || !role) {
                showNotif('Please fill in all fields.', 'warning');
                return;
            }

            ajax('/api/user/AddEditUser',
                { userId: parseInt(userId, 10), fullname, username, email, role, isActive },
                'modalEditUser');
        }

        // ── Reset Password ─────────────────────────────────────────
        function openResetModal(username) {
            currentResetUsername = username;
            document.getElementById('resetUsernameLabel').textContent = username;
            new bootstrap.Modal(document.getElementById('modalResetPass')).show();
        }

        function ResetPassword() {
            if (!currentResetUsername) return;
            const username = currentResetUsername;
            currentResetUsername = null;
            ajax('/api/user/ResetPassword', { username }, 'modalResetPass');
        }

        // ── Delete User ────────────────────────────────────────────
        function openDeleteModal(userId, username) {
            currentDeleteUserId = userId;
            document.getElementById('deleteUsernameLabel').textContent = username;
            new bootstrap.Modal(document.getElementById('modalDelete')).show();
        }

        function DeleteUser() {
            if (!currentDeleteUserId) return;
            const userId = currentDeleteUserId;
            currentDeleteUserId = null;

            closeModalThen('modalDelete', () => {
                $.ajax({
                    url:     `/api/user/DeleteUser/${userId}`,
                    type:    'DELETE',
                    headers: { 'RequestVerificationToken': getToken() },
                    success: (res) => {
                        queueNotif(res.message || 'User deleted successfully.', 'success');
                        location.reload();
                    },
                    error: (xhr) => {
                        let msg = xhr.responseJSON?.message || `Server error (${xhr.status}).`;
                        if (xhr.status === 401 || xhr.status === 403) msg = xhr.responseJSON?.message || 'Access denied.';
                        showNotif(msg, 'danger');
                    }
                });
            });
        }

    </script>
}
@page
@model ReportSystem.Pages.ReportFormModel
@{
    ViewData["Title"] = "Report Form";
}

<div class="container-body">
    <div class="row mb-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h4 class="fw-bold mb-1">Report Form</h4>
            <small class="text-muted">Fill in the report details below.</small>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <form method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="reportTime" class="form-label fw-semibold">Time</label>
                            <input id="reportTime"
                                   type="text"
                                   class="form-control"
                                   value="@Model.CurrentTimeDisplay"
                                   readonly />
                            <div class="form-text">Automated timestamp.</div>
                        </div>

                        <div class="mb-3">
                            <label for="reportName" class="form-label fw-semibold">Name</label>
                            <input id="reportName"
                                   name="Name"
                                   type="text"
                                   class="form-control"
                                   placeholder="Enter your name" />
                        </div>

                        <div class="mb-3">
                            <label for="reportAreaMachine" class="form-label fw-semibold">Area/Machine</label>
                            <input id="reportAreaMachine"
                                   name="AreaMachine"
                                   type="text"
                                   class="form-control"
                                   placeholder="Enter area or machine" />
                        </div>

                        <div class="mb-3">
                            <label for="reportDescription" class="form-label fw-semibold">Description</label>
                            <textarea id="reportDescription"
                                      name="Description"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Write the report details"></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="reportPhoto" class="form-label fw-semibold">Upload Photo (Optional)</label>
                            <input id="reportPhoto"
                                   name="Photo"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />
                            <div class="form-text">Optional image upload.</div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

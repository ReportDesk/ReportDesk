@page
@model ReportSystem.Pages.Report.KaizenModel
@{
    ViewData["Title"] = Model.PageHeading;
}

<div class="container-body">
    <div class="row mb-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h4 class="fw-bold mb-1">@Model.PageHeading</h4>
            <small class="text-muted">@Model.PageDescription</small>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="row">
            <div class="col-12 col-md-10 col-lg-8 mx-auto">
                <div class="alert alert-success">@Model.SuccessMessage</div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <form id="reportForm" method="post">
                        <div id="formError" class="text-danger mb-2 d-none"></div>
                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Waktu</label>
                                <input type="text" class="form-control" value="@Model.CurrentTimeDisplay" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Pelapor<span class="text-danger">*</span></label>
                                <input name="name" class="form-control" placeholder="Enter your name" />
                                <span  class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Area<span class="text-danger">*</span></label>
                                <input name="area" class="form-control" placeholder="Enter area" />
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Kondisi Sebelum<span class="text-danger">*</span></label>
                                <textarea name="description" class="form-control" rows="6" placeholder="Write the report details"></textarea>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Foto Sebelum (Optional)</label>
                                <input id="beforePhotoInput" type="file" class="form-control" accept=".jpg,.jpeg,.png" multiple />
                                <div id="beforePhotoStatus" class="form-text text-muted mt-1"></div>
                                <div id="beforePhotoPreviewList" class="mt-2 row g-2"></div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Kondisi Sesudah<span class="text-danger">*</span></label>
                                <textarea name="description2" class="form-control" rows="6" placeholder="Write the report details"></textarea>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Foto Sesudah (Optional)</label>
                                <input id="afterPhotoInput" type="file" class="form-control" accept=".jpg,.jpeg,.png" multiple />
                                <div id="afterPhotoStatus" class="form-text text-muted mt-1"></div>
                                <div id="afterPhotoPreviewList" class="mt-2 row g-2"></div>
                            </div>
                            <div class="col-12 d-grid">
                                <button type="submit" id="submitBtn" class="btn btn-primary">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            let beforePhotos = [];
            let afterPhotos = [];
            let activeUploadCount = 0;

            const submitBtn = document.getElementById("submitBtn");
            const formError = document.getElementById("formError");

            function showFormError(msg) {
                formError.textContent = msg;
                formError.classList.remove("d-none");
            }

            function clearErrors() {
                formError.textContent = "";
                formError.classList.add("d-none");
            }

            function setSubmitState(disabled, text = "Submit") {
                submitBtn.disabled = disabled;
                submitBtn.textContent = text;
            }

            async function readJsonSafe(response) {
                const text = await response.text();
                if (!text) return {};

                try {
                    return JSON.parse(text);
                } catch {
                    return {};
                }
            }

            function updateSlotStatus(statusEl, photos, activeCount) {
                if (activeCount > 0) {
                    const suffix = activeCount === 1 ? "" : "s";
                    statusEl.textContent = `Uploading ${activeCount} photo${suffix}…`;
                    statusEl.className = "form-text text-muted mt-1";
                    return;
                }

                if (photos.length === 0) {
                    statusEl.textContent = "";
                    statusEl.className = "form-text text-muted mt-1";
                    return;
                }

                const suffix = photos.length === 1 ? "" : "s";
                statusEl.textContent = `${photos.length} photo${suffix} ready.`;
                statusEl.className = "form-text text-success mt-1";
            }

            function renderPhotoList(container, photos) {
                container.innerHTML = "";

                photos.forEach((photo) => {
                    const item = document.createElement("div");
                    item.className = "col-6 col-md-4";
                    item.innerHTML = `
                        <div class="position-relative border rounded p-2 h-100">
                            <img src="${photo.previewUrl}" alt="Preview"
                                 class="img-fluid rounded"
                                 style="max-height:160px; width:100%; object-fit:cover;" />
                            <button type="button"
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1"
                                    data-temp-key="${photo.tempKey}"
                                    title="Remove photo">
                                ✕
                            </button>
                        </div>`;
                    container.appendChild(item);
                });
            }

            function wirePhotoSlot({ inputId, statusId, previewListId, getPhotos, setPhotos }) {
                const input = document.getElementById(inputId);
                const status = document.getElementById(statusId);
                const previewList = document.getElementById(previewListId);
                let slotActiveUploads = 0;

                input.addEventListener("change", async function () {
                    const files = Array.from(this.files || []);
                    if (files.length === 0) return;

                    clearErrors();
                    input.disabled = true;
                    slotActiveUploads += files.length;
                    activeUploadCount += files.length;
                    updateSlotStatus(status, getPhotos(), slotActiveUploads);
                    setSubmitState(true, "Uploading photo…");

                    for (const file of files) {
                        const fd = new FormData();
                        fd.append("file", file);

                        try {
                            const res = await fetch("/api/upload/temp", { method: "POST", body: fd });
                            const data = await readJsonSafe(res);

                            if (!res.ok) {
                                status.textContent = data.error || data.message || `Upload failed for ${file.name}.`;
                                status.className = "form-text text-danger mt-1";
                                continue;
                            }

                            const nextPhotos = getPhotos().slice();
                            nextPhotos.push({
                                tempKey: data.tempKey,
                                uploadOwnerToken: data.uploadOwnerToken,
                                previewUrl: data.previewUrl
                            });
                            setPhotos(nextPhotos);
                            renderPhotoList(previewList, nextPhotos);
                        } catch {
                            status.textContent = `Upload error for ${file.name}. Please try again.`;
                            status.className = "form-text text-danger mt-1";
                        } finally {
                            slotActiveUploads -= 1;
                            activeUploadCount -= 1;
                            updateSlotStatus(status, getPhotos(), slotActiveUploads);
                        }
                    }

                    input.value = "";
                    input.disabled = false;
                    setSubmitState(false, "Submit");
                });

                previewList.addEventListener("click", async function (e) {
                    const removeButton = e.target.closest("button[data-temp-key]");
                    if (!removeButton) return;

                    const tempKey = removeButton.dataset.tempKey;
                    const photo = getPhotos().find(x => x.tempKey === tempKey);
                    if (!photo) return;

                    removeButton.disabled = true;
                    await deleteTempKey(photo);
                    const nextPhotos = getPhotos().filter(x => x.tempKey !== tempKey);
                    setPhotos(nextPhotos);
                    renderPhotoList(previewList, nextPhotos);
                    updateSlotStatus(status, nextPhotos, slotActiveUploads);
                });
            }

            async function deleteTempKey(photo) {
                if (!photo?.tempKey || !photo?.uploadOwnerToken) return;

                try {
                    await fetch("/api/upload/temp", {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            tempKey: photo.tempKey,
                            uploadOwnerToken: photo.uploadOwnerToken
                        })
                    });
                } catch { }
            }

            wirePhotoSlot({
                inputId: "beforePhotoInput",
                statusId: "beforePhotoStatus",
                previewListId: "beforePhotoPreviewList",
                getPhotos: () => beforePhotos,
                setPhotos: (photos) => { beforePhotos = photos; }
            });

            wirePhotoSlot({
                inputId: "afterPhotoInput",
                statusId: "afterPhotoStatus",
                previewListId: "afterPhotoPreviewList",
                getPhotos: () => afterPhotos,
                setPhotos: (photos) => { afterPhotos = photos; }
            });

            document.getElementById("reportForm").addEventListener("submit", async function (e) {
                e.preventDefault();

                clearErrors();
                if (activeUploadCount > 0) {
                    showFormError("Please wait until all photo uploads finish before submitting.");
                    return;
                }

                setSubmitState(true, "Submitting…");

                const fd = new FormData(this);
                fd.append("ReportType", "Kaizen");

                for (const photo of beforePhotos) {
                    fd.append("beforePhotoTempKeys", photo.tempKey);
                    fd.append("beforePhotoUploadOwnerTokens", photo.uploadOwnerToken);
                }

                for (const photo of afterPhotos) {
                    fd.append("afterPhotoTempKeys", photo.tempKey);
                    fd.append("afterPhotoUploadOwnerTokens", photo.uploadOwnerToken);
                }

                try {
                    const res = await fetch("/api/report/submit", { method: "POST", body: fd });
                    const data = await readJsonSafe(res);

                    if (res.ok) {
                        window.location.href = "/Success";
                    } else {
                        const message = data.message || data.error || "Submission failed.";
                        showFormError(message);
                        setSubmitState(false, "Submit");
                    }
                } catch {
                    showFormError("An error occurred. Please try again.");
                    setSubmitState(false, "Submit");
                }
            });
        })();
    </script>
}

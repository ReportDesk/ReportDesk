@page
@model ReportSystem.Pages.Report.KaizenModel
@{
    ViewData["Title"] = Model.PageHeading;
}

<div class="container-body">
    <div class="row mb-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h4 class="fw-bold mb-1">@Model.PageHeading</h4>
            <small class="text-muted">@Model.PageDescription</small>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="row">
            <div class="col-12 col-md-10 col-lg-8 mx-auto">
                <div class="alert alert-success">@Model.SuccessMessage</div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <form id="reportForm" method="post">
                        <div class="text-danger mb-2"></div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Title</label>
                                <input name="title" class="form-control" placeholder="Enter report title" />
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Time</label>
                                <input type="text" class="form-control" value="@Model.CurrentTimeDisplay" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Name</label>
                                <input name="name" class="form-control" placeholder="Enter your name" />
                                <span  class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Area</label>
                                <input name="area" class="form-control" placeholder="Enter area" />
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Description</label>
                                <textarea name="description" class="form-control" rows="6" placeholder="Write the report details"></textarea>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Foto Sebelum</label>
                                <input id="photoInput" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                                <div id="photoStatus" class="form-text text-muted mt-1"></div>
                                <div id="photoPreview" class="mt-2 d-none">
                                    <div class="position-relative d-inline-block">
                                        <img id="photoPreviewImg" src="" alt="Preview"
                                             class="rounded border" style="max-height:160px; max-width:100%;" />
                                        <button type="button" id="photoRemoveBtn"
                                                class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1"
                                                title="Remove photo">
                                            ✕
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Foto Sesudah</label>
                                @* <input id="photoInput" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                                <div id="photoStatus" class="form-text text-muted mt-1"></div>
                                <div id="photoPreview" class="mt-2 d-none">
                                    <div class="position-relative d-inline-block">
                                        <img id="photoPreviewImg" src="" alt="Preview"
                                             class="rounded border" style="max-height:160px; max-width:100%;" />
                                        <button type="button" id="photoRemoveBtn"
                                                class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1"
                                                title="Remove photo">
                                            ✕
                                        </button>
                                    </div>
                                </div> *@
                            </div>
                            <div class="col-12 d-grid">
                                <button type="submit" id="submitBtn" class="btn btn-primary">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            // ── state ────────────────────────────────────────────────────────
            let photoTempKey = null;   // set after successful temp upload

            const photoInput     = document.getElementById("photoInput");
            const photoStatus    = document.getElementById("photoStatus");
            const photoPreview   = document.getElementById("photoPreview");
            const photoPreviewImg = document.getElementById("photoPreviewImg");
            const photoRemoveBtn = document.getElementById("photoRemoveBtn");
            const submitBtn      = document.getElementById("submitBtn");

            // ── helpers ──────────────────────────────────────────────────────
            function setPhotoStatus(msg, type = "muted") {
                photoStatus.textContent = msg;
                photoStatus.className = `form-text text-${type} mt-1`;
            }

            function clearPhoto() {
                photoTempKey = null;
                photoInput.value = "";
                photoPreview.classList.add("d-none");
                photoPreviewImg.src = "";
                setPhotoStatus("");
            }

            // ── upload on file select ────────────────────────────────────────
            photoInput.addEventListener("change", async function () {
                const file = this.files[0];
                if (!file) return;

                // If user swaps file while a previous temp exists, remove the old one first
                if (photoTempKey) {
                    await deleteTempKey(photoTempKey);
                    photoTempKey = null;
                }

                setPhotoStatus("Uploading…", "muted");
                photoInput.disabled = true;

                try {
                    const fd = new FormData();
                    fd.append("file", file);

                    const res  = await fetch("/api/upload/temp", { method: "POST", body: fd });
                    const data = await res.json();

                    if (!res.ok) {
                        setPhotoStatus(data.error || "Upload failed.", "danger");
                        photoInput.disabled = false;
                        photoInput.value = "";
                        return;
                    }

                    photoTempKey = data.tempKey;
                    photoPreviewImg.src = data.previewUrl;
                    photoPreview.classList.remove("d-none");
                    setPhotoStatus("Photo ready.", "success");
                } catch {
                    setPhotoStatus("Upload error. Please try again.", "danger");
                } finally {
                    photoInput.disabled = false;
                }
            });

            // ── remove photo ─────────────────────────────────────────────────
            photoRemoveBtn.addEventListener("click", async function () {
                if (!photoTempKey) { clearPhoto(); return; }
                this.disabled = true;
                await deleteTempKey(photoTempKey);
                clearPhoto();
                this.disabled = false;
            });

            // ── delete helper ────────────────────────────────────────────────
            async function deleteTempKey(key) {
                try {
                    await fetch("/api/upload/temp", {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ tempKey: key })
                    });
                } catch {
                    // Best-effort; cleanup service will handle it if this fails
                }
            }

            // ── form submit ──────────────────────────────────────────────────
            document.getElementById("reportForm").addEventListener("submit", async function (e) {
                e.preventDefault();

                submitBtn.disabled = true;
                submitBtn.textContent = "Submitting…";

                const fd = new FormData(this);
                fd.append("ReportType", "Kaizen");

                // Attach the temp key (may be null if user skipped the photo)
                if (photoTempKey) fd.append("photoTempKey", photoTempKey);

                try {
                    console.log("Submitting Report");
                    const res  = await fetch("/api/report/submit", { method: "POST", body: fd });
                    const data = await res.json();

                    if (res.ok) {
                        window.location.href = "/Success";
                    } else {
                        alert(data.message || "Submission failed.");
                        submitBtn.disabled = false;
                        submitBtn.textContent = "Submit";
                    }
                } catch {
                    alert("An error occurred. Please try again.");
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Submit";
                }
            });
        })();
    </script>
}

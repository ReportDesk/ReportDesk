@page
@model ReportSystem.Pages.Report.KaizenModel
@{
    ViewData["Title"] = Model.PageHeading;
}

<div class="container-body">
    <div class="row mb-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h4 class="fw-bold mb-1">@Model.PageHeading</h4>
            <small class="text-muted">@Model.PageDescription</small>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="row">
            <div class="col-12 col-md-10 col-lg-8 mx-auto">
                <div class="alert alert-success">@Model.SuccessMessage</div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <form id="reportForm" method="post">
                        <div class="text-danger mb-2"></div>
                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Waktu</label>
                                <input type="text" class="form-control" value="@Model.CurrentTimeDisplay" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Pelapor<span class="text-danger">*</span></label>
                                <input name="name" class="form-control" placeholder="Enter your name" />
                                <span  class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Area<span class="text-danger">*</span></label>
                                <input name="area" class="form-control" placeholder="Enter area" />
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Kondisi Sebelum<span class="text-danger">*</span></label>
                                <textarea name="description" class="form-control" rows="6" placeholder="Write the report details"></textarea>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Foto Sebelum (Optional)</label>
                                <input id="beforePhotoInput" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                                <div id="beforePhotoStatus" class="form-text text-muted mt-1"></div>
                                <div id="beforePhotoPreview" class="mt-2 d-none">
                                    <div class="position-relative d-inline-block">
                                        <img id="beforePhotoPreviewImg" src="" alt="Preview"
                                             class="rounded border" style="max-height:160px; max-width:100%;" />
                                        <button type="button" id="beforePhotoRemoveBtn"
                                                class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1"
                                                title="Remove photo">
                                            ✕
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Kondisi Sesudah<span class="text-danger">*</span></label>
                                <textarea name="description2" class="form-control" rows="6" placeholder="Write the report details"></textarea>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Foto Sesudah (Optional)</label>
                                <input id="afterPhotoInput" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                                <div id="afterPhotoStatus" class="form-text text-muted mt-1"></div>
                                <div id="afterPhotoPreview" class="mt-2 d-none">
                                    <div class="position-relative d-inline-block">
                                        <img id="afterPhotoPreviewImg" src="" alt="Preview"
                                             class="rounded border" style="max-height:160px; max-width:100%;" />
                                        <button type="button" id="afterPhotoRemoveBtn"
                                                class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1"
                                                title="Remove photo">
                                            ✕
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 d-grid">
                                <button type="submit" id="submitBtn" class="btn btn-primary">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            // ── state ────────────────────────────────────────────────────────
            let beforeTempKey = null;
            let afterTempKey  = null;

            const submitBtn = document.getElementById("submitBtn");

            // ── generic upload/remove wiring ─────────────────────────────────
            function wirePhotoSlot({ inputId, statusId, previewId, previewImgId, removeBtnId, getTempKey, setTempKey }) {
                const input      = document.getElementById(inputId);
                const status     = document.getElementById(statusId);
                const preview    = document.getElementById(previewId);
                const previewImg = document.getElementById(previewImgId);
                const removeBtn  = document.getElementById(removeBtnId);

                function setStatus(msg, type = "muted") {
                    status.textContent = msg;
                    status.className = `form-text text-${type} mt-1`;
                }

                function clearSlot() {
                    setTempKey(null);
                    input.value = "";
                    preview.classList.add("d-none");
                    previewImg.src = "";
                    setStatus("");
                }

                input.addEventListener("change", async function () {
                    const file = this.files[0];
                    if (!file) return;

                    if (getTempKey()) {
                        await deleteTempKey(getTempKey());
                        setTempKey(null);
                    }

                    setStatus("Uploading…", "muted");
                    input.disabled = true;

                    try {
                        const fd = new FormData();
                        fd.append("file", file);

                        const res  = await fetch("/api/upload/temp", { method: "POST", body: fd });
                        const data = await res.json();

                        if (!res.ok) {
                            setStatus(data.error || "Upload failed.", "danger");
                            input.value = "";
                            return;
                        }

                        setTempKey(data.tempKey);
                        previewImg.src = data.previewUrl;
                        preview.classList.remove("d-none");
                        setStatus("Photo ready.", "success");
                    } catch {
                        setStatus("Upload error. Please try again.", "danger");
                    } finally {
                        input.disabled = false;
                    }
                });

                removeBtn.addEventListener("click", async function () {
                    if (!getTempKey()) { clearSlot(); return; }
                    this.disabled = true;
                    await deleteTempKey(getTempKey());
                    clearSlot();
                    this.disabled = false;
                });
            }

            wirePhotoSlot({
                inputId: "beforePhotoInput", statusId: "beforePhotoStatus",
                previewId: "beforePhotoPreview", previewImgId: "beforePhotoPreviewImg",
                removeBtnId: "beforePhotoRemoveBtn",
                getTempKey: () => beforeTempKey,
                setTempKey: (k) => { beforeTempKey = k; }
            });

            wirePhotoSlot({
                inputId: "afterPhotoInput", statusId: "afterPhotoStatus",
                previewId: "afterPhotoPreview", previewImgId: "afterPhotoPreviewImg",
                removeBtnId: "afterPhotoRemoveBtn",
                getTempKey: () => afterTempKey,
                setTempKey: (k) => { afterTempKey = k; }
            });

            // ── delete helper ────────────────────────────────────────────────
            async function deleteTempKey(key) {
                try {
                    await fetch("/api/upload/temp", {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ tempKey: key })
                    });
                } catch { /* best-effort */ }
            }

            // ── form submit ──────────────────────────────────────────────────
            document.getElementById("reportForm").addEventListener("submit", async function (e) {
                e.preventDefault();

                submitBtn.disabled = true;
                submitBtn.textContent = "Submitting…";

                const fd = new FormData(this);
                fd.append("ReportType", "Kaizen");

                if (beforeTempKey) fd.append("BeforePhotoTempKey", beforeTempKey);
                if (afterTempKey)  fd.append("AfterPhotoTempKey",  afterTempKey);

                try {
                    const res  = await fetch("/api/report/submit", { method: "POST", body: fd });
                    const data = await res.json();

                    if (res.ok) {
                        window.location.href = "/Success";
                    } else {
                        alert(data.message || "Submission failed.");
                        submitBtn.disabled = false;
                        submitBtn.textContent = "Submit";
                    }
                } catch {
                    alert("An error occurred. Please try again.");
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Submit";
                }
            });
        })();
    </script>
}

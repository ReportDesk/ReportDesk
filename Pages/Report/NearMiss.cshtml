@page
@model ReportSystem.Pages.Report.NearMissModel
@{
    ViewData["Title"] = Model.PageHeading;
}

<div class="container-body">
    <div class="row mb-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h4 class="fw-bold mb-1">@Model.PageHeading</h4>
            <small class="text-muted">@Model.PageDescription</small>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="row">
            <div class="col-12 col-md-10 col-lg-8 mx-auto">
                <div class="alert alert-success">@Model.SuccessMessage</div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <form id="reportForm" method="post">
                        <div id="formError" class="text-danger mb-2 d-none"></div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Waktu</label>
                                <input type="text" class="form-control" value="@Model.CurrentTimeDisplay" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Pelapor<span class="text-danger">*</span></label>
                                <input name="name" class="form-control" placeholder="Enter your name" />
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Area<span class="text-danger">*</span></label>
                                <input name="area" class="form-control" placeholder="Enter area" />
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Kondisi Berbahaya<span class="text-danger">*</span></label>
                                <textarea name="description" class="form-control" rows="6" placeholder="Write the report details"></textarea>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Upload Foto (Optional)</label>
                                <input id="photoInput" type="file" class="form-control" accept=".jpg,.jpeg,.png" multiple />
                                <div id="photoStatus" class="form-text text-muted mt-1"></div>
                                <div id="photoPreviewList" class="mt-2 row g-2"></div>
                            </div>

                            <div class="col-12 d-grid">
                                <button type="submit" id="submitBtn" class="btn btn-primary">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="photoErrorModal" tabindex="-1" aria-labelledby="photoErrorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger" id="photoErrorModalLabel">Photo Could Not Be Accepted</h5>
            </div>
            <div class="modal-body pt-0">
                <p id="photoErrorMessage" class="mb-2"></p>
                <p class="text-muted small mb-0">Choose the original photo file from your device and try again.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            let uploadedPhotos = [];
            let activeUploadCount = 0;

            const photoInput = document.getElementById("photoInput");
            const photoStatus = document.getElementById("photoStatus");
            const photoPreviewList = document.getElementById("photoPreviewList");
            const submitBtn = document.getElementById("submitBtn");
            const formError = document.getElementById("formError");
            const photoErrorModal = new bootstrap.Modal(document.getElementById("photoErrorModal"));
            const photoErrorMessage = document.getElementById("photoErrorMessage");

            function setPhotoStatus(msg, type = "muted") {
                photoStatus.textContent = msg;
                photoStatus.className = `form-text text-${type} mt-1`;
            }

            function showPhotoError(message) {
                photoErrorMessage.textContent = message;
                photoErrorModal.show();
            }

            function clearPendingSelection() {
                photoInput.value = "";
            }

            function showFormError(msg) {
                formError.textContent = msg;
                formError.classList.remove("d-none");
            }

            function clearErrors() {
                formError.textContent = "";
                formError.classList.add("d-none");
            }

            function setSubmitState(disabled, text = "Submit") {
                submitBtn.disabled = disabled;
                submitBtn.textContent = text;
            }

            function updatePhotoStatus() {
                if (activeUploadCount > 0) {
                    const suffix = activeUploadCount === 1 ? "" : "s";
                    setPhotoStatus(`Uploading ${activeUploadCount} photo${suffix}…`, "muted");
                    return;
                }

                if (uploadedPhotos.length === 0) {
                    setPhotoStatus("");
                    return;
                }

                const suffix = uploadedPhotos.length === 1 ? "" : "s";
                setPhotoStatus(`${uploadedPhotos.length} photo${suffix} ready.`, "success");
            }

            function renderPhotoPreviews() {
                photoPreviewList.innerHTML = "";

                uploadedPhotos.forEach((photo) => {
                    const item = document.createElement("div");
                    item.className = "col-6 col-md-4";
                    item.innerHTML = `
                        <div class="position-relative border rounded p-2 h-100">
                            <img src="${photo.previewUrl}" alt="Preview"
                                 class="img-fluid rounded"
                                 style="max-height:160px; width:100%; object-fit:cover;" />
                            <button type="button"
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1"
                                    data-temp-key="${photo.tempKey}"
                                    title="Remove photo">
                                ✕
                            </button>
                        </div>`;
                    photoPreviewList.appendChild(item);
                });
            }

            async function readJsonSafe(response) {
                const text = await response.text();
                if (!text) return {};

                try {
                    return JSON.parse(text);
                } catch {
                    return {};
                }
            }

            photoInput.addEventListener("change", async function () {
                const files = Array.from(this.files || []);
                if (files.length === 0) return;

                clearErrors();
                photoInput.disabled = true;
                activeUploadCount += files.length;
                updatePhotoStatus();
                setSubmitState(true, "Uploading photo…");

                for (const file of files) {
                    const fd = new FormData();
                    fd.append("file", file);
                    fd.append("purpose", "report-submission");

                    try {
                        const res = await fetch("/api/upload/temp", { method: "POST", body: fd });
                        const data = await readJsonSafe(res);

                        if (!res.ok) {
                            const message = data.error || data.message || `Upload failed for ${file.name}.`;
                            setPhotoStatus(message, "danger");
                            showPhotoError(message);
                            continue;
                        }

                        uploadedPhotos.push({
                            tempKey: data.tempKey,
                            uploadOwnerToken: data.uploadOwnerToken,
                            previewUrl: data.previewUrl
                        });
                        renderPhotoPreviews();
                    } catch {
                        setPhotoStatus(`Upload error for ${file.name}. Please try again.`, "danger");
                    } finally {
                        activeUploadCount -= 1;
                        updatePhotoStatus();
                    }
                }

                clearPendingSelection();
                photoInput.disabled = false;
                setSubmitState(false, "Submit");
            });

            photoPreviewList.addEventListener("click", async function (e) {
                const removeButton = e.target.closest("button[data-temp-key]");
                if (!removeButton) return;

                const tempKey = removeButton.dataset.tempKey;
                const photo = uploadedPhotos.find(x => x.tempKey === tempKey);
                if (!photo) return;

                removeButton.disabled = true;
                await deleteTempKey(photo);
                uploadedPhotos = uploadedPhotos.filter(x => x.tempKey !== tempKey);
                renderPhotoPreviews();
                updatePhotoStatus();
            });

            async function deleteTempKey(photo) {
                if (!photo?.tempKey || !photo?.uploadOwnerToken) return;

                try {
                    await fetch("/api/upload/temp", {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            tempKey: photo.tempKey,
                            uploadOwnerToken: photo.uploadOwnerToken
                        })
                    });
                } catch {
                }
            }

            document.getElementById("reportForm").addEventListener("submit", async function (e) {
                e.preventDefault();

                clearErrors();
                if (activeUploadCount > 0) {
                    showFormError("Please wait until the photo upload finishes before submitting.");
                    return;
                }

                setSubmitState(true, "Submitting…");

                const fd = new FormData(this);
                fd.append("ReportType", "NearMiss");

                for (const photo of uploadedPhotos) {
                    fd.append("photoTempKeys", photo.tempKey);
                    fd.append("photoUploadOwnerTokens", photo.uploadOwnerToken);
                }

                try {
                    const res = await fetch("/api/report/submit", { method: "POST", body: fd });
                    const data = await readJsonSafe(res);

                    if (res.ok) {
                        if (data.reportId) {
                            window.location.href = `/Success?reportId=${encodeURIComponent(data.reportId)}`;
                            return;
                        }

                        showFormError("Report submitted, but the submitted report data could not be loaded.");
                        setSubmitState(false, "Submit");
                    } else {
                        const message = data.message || data.error || "Submission failed.";
                        showFormError(message);
                        setSubmitState(false, "Submit");
                    }
                } catch {
                    showFormError("An error occurred. Please try again.");
                    setSubmitState(false, "Submit");
                }
            });
        })();
    </script>
}

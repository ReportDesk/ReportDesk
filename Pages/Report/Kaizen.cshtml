@page
@model ReportSystem.Pages.Report.KaizenModel
@{
    ViewData["Title"] = Model.PageHeading;
}

<div class="container-body">
    <div class="row mb-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h4 class="fw-bold mb-1">@Model.PageHeading</h4>
            <small class="text-muted">@Model.PageDescription</small>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="row">
            <div class="col-12 col-md-10 col-lg-8 mx-auto">
                <div class="alert alert-success">@Model.SuccessMessage</div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <form method="post" enctype="multipart/form-data">
                        <div class="text-danger mb-2"></div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Title</label>
                                <input class="form-control" placeholder="Enter report title" />
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Time</label>
                                <input type="text" class="form-control" value="@Model.CurrentTimeDisplay" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Name</label>
                                <input class="form-control" placeholder="Enter your name" />
                                <span  class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Area</label>
                                <input class="form-control" placeholder="Enter area" />
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Description</label>
                                <textarea  class="form-control" rows="6" placeholder="Write the report details"></textarea>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label  class="form-label fw-semibold">Foto Sebelum</label>
                                <input type="file" class="form-control" accept="image/*" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Foto Sesudah</label>
                                <input type="file" class="form-control" accept="image/*" />
                            </div>
                            <div class="col-12 d-grid">
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector("form").addEventListener("submit", async function (e) {
            e.preventDefault();

            const btn = this.querySelector("button[type=submit]");
            btn.disabled = true;
            btn.textContent = "Submitting...";

            const fd = new FormData(this);
            fd.append("reportType", "Kaizen"); // "Suggestion" | "Machine"

            try {
                const res = await fetch("/api/report/submit", { method: "POST", body: fd });
                const data = await res.json();

                if (res.ok) {
                    window.location.href = "/Success";
                } else {
                    alert(data.message || "Submission failed.");
                    btn.disabled = false;
                    btn.textContent = "Submit";
                }
            } catch {
                alert("An error occurred. Please try again.");
                btn.disabled = false;
                btn.textContent = "Submit";
            }
        });
    </script>
}

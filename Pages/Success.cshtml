@page
@model ReportSystem.Pages.SuccessModel
@{
    ViewData["Title"] = "Success";
}

<div class="container-body">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="h4 fw-bold mb-2 text-dark">
                            Report Submitted Successfully
                        </h1>

                        <p class="mb-0 text-muted">
                            @Model.ThankYouMessage
                        </p>
                    </div>

                    <div class="border rounded bg-light p-3 p-md-4">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Waktu Laporan</label>
                                <input type="text" class="form-control bg-white" value="@Model.SubmissionDateText" readonly />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Dilaporkan oleh</label>
                                <input type="text" class="form-control bg-white" value="@Model.ReportedBy" readonly />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">@Model.ContextLabel</label>
                                <input type="text" class="form-control bg-white" value="@Model.ContextValue" readonly />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">@Model.DescriptionLabel</label>
                                <textarea class="form-control bg-white" rows="4" readonly>@Model.Description</textarea>
                            </div>

                            @if (Model.HasDescription2)
                            {
                                <div class="col-12">
                                    <label class="form-label fw-semibold">@Model.Description2Label</label>
                                    <textarea class="form-control bg-white" rows="4" readonly>@Model.Description2</textarea>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="/Index"
                           class="btn btn-primary w-100 py-2 fw-semibold"
                           style="border-radius: 10px;">
                            Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

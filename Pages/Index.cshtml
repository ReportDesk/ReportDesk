@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}
<div class="container-body">
    <div class="row mb-2">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <h5 class="fw-bold">Main Menu</h5>
        </div>
    </div>
    <div class="row">
        <!-- Machine Report -->
        <div class="col-lg-4 mb-4">
            <a href="/Report/Machine" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                <img class="card-img-top rounded-top"
                     src="~/asset/Machine.svg"
                     alt="Machine Report"
                     style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                    <h5 class="card-title fw-bold text-dark mb-1">Machine Report</h5>
                    <small class="text-muted">Melaporkan mesin atau peralatan yang rusak</small>
                </div>
            </a>
        </div>
        <!-- Near-Miss Report -->
        <div class="col-lg-4 mb-4">
            <a href="/Report/NearMiss" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                <img class="card-img-top rounded-top"
                     src="~/asset/Nearmiss.svg"
                     alt="Near-Miss Report"
                     style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                    <h5 class="card-title fw-bold text-dark mb-1">Near-Miss Report</h5>
                    <small class="text-muted">Melaporkan temuan kondisi yang berpotensi bahaya</small>
                </div>
            </a>
        </div>
        <!-- Suggestion -->
        <div class="col-lg-4 mb-4">
            <a href="/Report/Suggestion" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                <img class="card-img-top rounded-top"
                     src="~/asset/Suggestion.svg"
                     alt="Suggestion"
                     style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                    <h5 class="card-title fw-bold text-dark mb-1">Suggestion</h5>
                    <small class="text-muted">Melaporkan ide perbaikan di segala bidang</small>
                </div>
            </a>
        </div>
        <!-- Kaizen Report -->
        <div class="col-lg-4 mb-4">
            <a href="/Report/Kaizen" class="card border-0 rounded shadow text-decoration-none" style="border: 1px solid #e0e0e0 !important;">
                <img class="card-img-top rounded-top"
                     src="~/asset/Kaizen.svg"
                     alt="Kaizen Report"
                     style="height: 200px; width: 100%; object-fit: contain; background-color: #fff9ed; padding: 1rem;">
                <div class="card-body p-3" style="border-top: 1px solid #e0e0e0;">
                    <h5 class="card-title fw-bold text-dark mb-1">Kaizen Report</h5>
                    <small class="text-muted">Melaporkan kaizen yang sudah selesai dilakukan</small>
                </div>
            </a>
        </div>
    </div>
</div>
@page
@model ReportSystem.Pages.Admin.MasterAreaModel
@{ ViewData["Title"] = "Master Area"; }

<div class="container-body">
    <div class="row mb-2"><div class="col-6"><h3>Area Management</h3></div><div class="col-6"><button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#modalAddArea">New Area</button></div></div>
    <div class="row mb-2"><div class="col-12"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="~/Admin/Main">Home</a></li><li class="breadcrumb-item active">Master Area</li></ol></div></div>
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <div class="alert alert-success py-2">@Model.SuccessMessage</div> }
    <div class="card"><div class="card-body"><div class="table-responsive"><table class="table initDataTable"><thead class="table-light"><tr><th>Area Name</th><th>Building</th><th>Status</th><th>Action</th></tr></thead><tbody>
        @if (!Model.Areas.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">No areas found.</td></tr> }
        else { foreach (var area in Model.Areas) { <tr><td class="fw-semibold">@area.AreaName</td><td>@area.Building</td><td>@if (area.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td><td><button type="button" class="btn btn-warning btn-sm text-dark" onclick="openEditModal(@area.AreaId)">Edit</button> <button type="button" class="btn btn-outline-danger btn-sm" onclick="openDeleteModal(@area.AreaId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(area.AreaName))')">Deactivate</button></td></tr> } }
    </tbody></table></div></div></div>
</div>

<div class="modal fade" id="modalAddArea" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h6 class="modal-title fw-bold">Add New Area</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form method="post" asp-page-handler="Save" id="formAdd"><input type="hidden" name="EditId" value="" /><div class="modal-body"><div class="mb-3"><label class="form-label fw-semibold">Area Name</label><input type="text" class="form-control" id="addAreaName" name="Input.AreaName" placeholder="e.g. Production Floor A" /></div><div class="mb-3"><label class="form-label fw-semibold">Building</label><input type="text" class="form-control" id="addBuilding" name="Input.Building" placeholder="e.g. Building 1" /></div><div class="mb-3 form-check"><input type="checkbox" class="form-check-input" id="addIsActive" name="Input.IsActive" value="true" checked /><input type="hidden" name="Input.IsActive" value="false" /><label class="form-check-label fw-semibold" for="addIsActive">Active</label></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" onclick="submitAdd()">Add Area</button></div></form></div></div></div>
<div class="modal fade" id="modalEditArea" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h6 class="modal-title fw-bold">Edit Area</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form method="post" asp-page-handler="Save" id="formEdit"><input type="hidden" id="editAreaId" name="EditId" /><div class="modal-body"><div class="mb-3"><label class="form-label fw-semibold">Area Name</label><input type="text" class="form-control" id="editAreaName" name="Input.AreaName" /></div><div class="mb-3"><label class="form-label fw-semibold">Building</label><input type="text" class="form-control" id="editBuilding" name="Input.Building" /></div><div class="mb-3 form-check"><input type="checkbox" class="form-check-input" id="editIsActive" name="Input.IsActive" value="true" /><input type="hidden" name="Input.IsActive" value="false" /><label class="form-check-label fw-semibold" for="editIsActive">Active</label></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-warning text-dark" onclick="submitEdit()">Save Changes</button></div></form></div></div></div>
<div class="modal fade" id="modalDeleteArea" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-sm"><div class="modal-content"><div class="modal-header"><h6 class="modal-title fw-bold">Deactivate Area</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Deactivate <strong id="deleteAreaLabel"></strong>? This keeps existing reports unchanged.</div><form method="post" asp-page-handler="Delete"><input type="hidden" id="deleteAreaId" name="areaId" /><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger">Deactivate</button></div></form></div></div></div>

@section Scripts { <script>
    $(document).ready(() => $('table.initDataTable').DataTable({ pageLength: 10, lengthMenu: [5, 10, 25, 50], columnDefs: [{ orderable: false, targets: 3 }] }));
    const areas = @Html.Raw(Json.Serialize(Model.Areas));
    function submitAdd() { if (!document.getElementById('addAreaName').value.trim() || !document.getElementById('addBuilding').value.trim()) return alert('Area name and building are required.'); document.getElementById('formAdd').submit(); }
    function submitEdit() { if (!document.getElementById('editAreaName').value.trim() || !document.getElementById('editBuilding').value.trim()) return alert('Area name and building are required.'); document.getElementById('formEdit').submit(); }
    function openEditModal(id) { const item = areas.find(x => x.areaId === id); if (!item) return; document.getElementById('editAreaId').value = item.areaId; document.getElementById('editAreaName').value = item.areaName; document.getElementById('editBuilding').value = item.building; document.getElementById('editIsActive').checked = item.isActive; new bootstrap.Modal(document.getElementById('modalEditArea')).show(); }
    function openDeleteModal(id, name) { document.getElementById('deleteAreaId').value = id; document.getElementById('deleteAreaLabel').textContent = name; new bootstrap.Modal(document.getElementById('modalDeleteArea')).show(); }
</script> }

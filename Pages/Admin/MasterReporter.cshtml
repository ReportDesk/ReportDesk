@page
@model ReportSystem.Pages.Admin.MasterReporterModel
@{ ViewData["Title"] = "Master Pelapor"; }

<div class="container-body">
    <div class="row mb-2"><div class="col-6"><h3>Pelapor Management</h3></div><div class="col-6"><button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#modalAddReporter">New Pelapor</button></div></div>
    <div class="row mb-2"><div class="col-12"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="~/Admin/Main">Home</a></li><li class="breadcrumb-item active">Master Pelapor</li></ol></div></div>
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <div class="alert alert-success py-2">@Model.SuccessMessage</div> }
    <div class="card"><div class="card-body"><div class="table-responsive"><table class="table initDataTable"><thead class="table-light"><tr><th>Worker Name</th><th>Status</th><th>Action</th></tr></thead><tbody>
        @if (!Model.Reporters.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">No reporters found.</td></tr> }
        else { foreach (var reporter in Model.Reporters) { <tr><td class="fw-semibold">@reporter.ReporterName</td><td>@if (reporter.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td><td><button type="button" class="btn btn-warning btn-sm text-dark" onclick="openEditModal(@reporter.ReporterId)">Edit</button> <button type="button" class="btn btn-outline-danger btn-sm" onclick="openDeleteModal(@reporter.ReporterId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(reporter.ReporterName))')">Deactivate</button></td></tr> } }
    </tbody></table></div></div></div>
</div>

<div class="modal fade" id="modalAddReporter" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h6 class="modal-title fw-bold">Add New Pelapor</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form method="post" asp-page-handler="Save" id="formAdd"><input type="hidden" name="EditId" value="" /><div class="modal-body"><div class="mb-3"><label class="form-label fw-semibold">Worker Name</label><input type="text" class="form-control" id="addReporterName" name="Input.ReporterName" placeholder="e.g. John Doe" /></div><div class="mb-3 form-check"><input type="checkbox" class="form-check-input" id="addIsActive" name="Input.IsActive" value="true" checked /><input type="hidden" name="Input.IsActive" value="false" /><label class="form-check-label fw-semibold" for="addIsActive">Active</label></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" onclick="submitAdd()">Add Pelapor</button></div></form></div></div></div>
<div class="modal fade" id="modalEditReporter" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h6 class="modal-title fw-bold">Edit Pelapor</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form method="post" asp-page-handler="Save" id="formEdit"><input type="hidden" id="editReporterId" name="EditId" /><div class="modal-body"><div class="mb-3"><label class="form-label fw-semibold">Worker Name</label><input type="text" class="form-control" id="editReporterName" name="Input.ReporterName" /></div><div class="mb-3 form-check"><input type="checkbox" class="form-check-input" id="editIsActive" name="Input.IsActive" value="true" /><input type="hidden" name="Input.IsActive" value="false" /><label class="form-check-label fw-semibold" for="editIsActive">Active</label></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-warning text-dark" onclick="submitEdit()">Save Changes</button></div></form></div></div></div>
<div class="modal fade" id="modalDeleteReporter" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-sm"><div class="modal-content"><div class="modal-header"><h6 class="modal-title fw-bold">Deactivate Pelapor</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Deactivate <strong id="deleteReporterLabel"></strong>? This keeps existing reports unchanged.</div><form method="post" asp-page-handler="Delete"><input type="hidden" id="deleteReporterId" name="reporterId" /><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger">Deactivate</button></div></form></div></div></div>

@section Scripts { <script>
    $(document).ready(() => $('table.initDataTable').DataTable({ pageLength: 10, lengthMenu: [5, 10, 25, 50], columnDefs: [{ orderable: false, targets: 2 }] }));
    const reporters = @Html.Raw(Json.Serialize(Model.Reporters));
    function submitAdd() { if (!document.getElementById('addReporterName').value.trim()) return alert('Worker name is required.'); document.getElementById('formAdd').submit(); }
    function submitEdit() { if (!document.getElementById('editReporterName').value.trim()) return alert('Worker name is required.'); document.getElementById('formEdit').submit(); }
    function openEditModal(id) { const item = reporters.find(x => x.reporterId === id); if (!item) return; document.getElementById('editReporterId').value = item.reporterId; document.getElementById('editReporterName').value = item.reporterName; document.getElementById('editIsActive').checked = item.isActive; new bootstrap.Modal(document.getElementById('modalEditReporter')).show(); }
    function openDeleteModal(id, name) { document.getElementById('deleteReporterId').value = id; document.getElementById('deleteReporterLabel').textContent = name; new bootstrap.Modal(document.getElementById('modalDeleteReporter')).show(); }
</script> }

@page
@model ReportSystem.Pages.Admin.ReportListModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<style>
    @@media (max-width: 768px) {

        .mobile-filter-stack {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 0.75rem !important;
        }

            .mobile-filter-stack > div {
                width: 100%;
            }

            .mobile-filter-stack .form-control,
            .mobile-filter-stack .form-select,
            .mobile-filter-stack .btn {
                width: 100% !important;
                min-width: unset !important;
            }

        .mobile-status-group {
            gap: 0.75rem !important;
        }

        .mobile-action-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

            .mobile-action-group .btn {
                width: 100%;
            }

        .table-responsive {
            font-size: 0.875rem;
        }

        .table td,
        .table th {
            white-space: nowrap;
            vertical-align: middle;
        }

        .mobile-truncate {
            max-width: 140px !important;
        }

        .card-body {
            padding: 1rem !important;
        }
    }
</style>

<div class="container-body">

    <div class="row mb-3">
        <div class="col-12">
            <h3 class="fw-bold mb-1">@Model.PageTitle List</h3>
        </div>
    </div>

    @if (HttpContext.Session.GetString("Role") == "Admin" || HttpContext.Session.GetString("Role") == "Machine")
    {
        <!-- Breadcrumb -->
        <div class="row mb-2">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="~/Admin/Main">Home</a></li>
                    <li class="breadcrumb-item active">User Management</li>
                </ol>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.LoadError))
    {
        <div class="alert alert-warning" role="alert">
            @Model.LoadError
        </div>
    }

    <div>
        <div class="py-2">
            <form method="get">
                <input type="hidden" asp-for="ReportType" />

                <div class="d-flex flex-wrap justify-content-start align-items-end gap-3 mobile-filter-stack">

                    <div>
                        <label class="form-label fw-semibold small mb-1" for="fromDate">
                            From Date
                        </label>
                        <input id="fromDate"
                               asp-for="FromDate"
                               type="date"
                               class="form-control form-control-sm"
                               style="min-width:140px" />
                    </div>

                    <div>
                        <label class="form-label fw-semibold small mb-1" for="toDate">
                            To Date
                        </label>
                        <input id="toDate"
                               asp-for="ToDate"
                               type="date"
                               class="form-control form-control-sm"
                               style="min-width:140px" />
                    </div>

                    @if (Model.IsMachineType)
                    {
                        <div>
                            <label class="form-label fw-semibold small mb-1" for="machineId">
                                Machine
                            </label>

                            <select id="machineId"
                                    asp-for="MachineId"
                                    asp-items="Model.MachineOptions"
                                    class="form-select form-select-sm"
                                    style="min-width:180px">
                                <option value="">All Machines</option>
                            </select>
                        </div>
                    }

                    <div>
                        <label class="form-label fw-semibold small mb-1 d-block">
                            Status
                        </label>

                        <div class="d-flex flex-wrap align-items-center mobile-status-group gap-3">
                            @foreach (var s in new[] { "open", "on progress", "close" })
                            {
                                var labelId = "status_" + s.Replace(" ", "");

                                var labelText = s switch
                                {
                                    "open" => "Open",
                                    "on progress" => "On Progress",
                                    "close" => "Close",
                                    _ => s
                                };

                                <div class="form-check mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="Status"
                                           value="@s"
                                           id="@labelId"
                                           @(Model.IsStatusSelected(s) ? "checked" : "") />

                                    <label class="form-check-label small" for="@labelId">
                                        @labelText
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2 align-items-end mobile-action-group">
                        <button type="submit"
                                class="btn btn-primary btn-sm px-3">
                            Apply Filter
                        </button>

                        <a asp-page="/Admin/ReportList"
                           asp-route-reportType="@Model.ReportType"
                           class="btn btn-outline-secondary btn-sm px-3">
                            Reset
                        </a>

                        <button type="button"
                                class="btn btn-success btn-sm px-3"
                                data-bs-toggle="modal"
                                data-bs-target="#exportExcelModal">
                            <i class="bi bi-file-earmark-excel me-1"></i>
                            Export Excel
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-3 p-lg-4">

            <div class="table-responsive">
                <table class="table initDataTable align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width:120px">Status</th>
                            <th scope="col" style="width:115px">Time</th>
                            <th scope="col">@Model.ContextColumnLabel</th>
                            <th scope="col">Reporter</th>
                            <th scope="col">Description</th>
                            <th scope="col"
                                style="width:80px"
                                class="text-center">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var report in Model.ReportRows)
                        {
                            var (pillClass, pillLabel) = report.Status?.ToLowerInvariant() switch
                            {
                                "open"
                                => ("bg-success-subtle text-success border border-success-subtle", "open"),

                                "on progress" or "onprogress" or "on-progress"
                                => ("bg-warning-subtle text-warning border border-warning-subtle", "on progress"),

                                "close" or "closed"
                                => ("bg-danger-subtle text-danger border border-danger-subtle", "close"),

                                _ => ("bg-secondary-subtle text-secondary border border-secondary-subtle",
                                report.Status ?? "—")
                            };

                            <tr>

                                <td>
                                    <span class="badge rounded-pill fw-semibold px-3 py-2 @pillClass">
                                        @pillLabel
                                    </span>
                                </td>

                                <td class="text-nowrap">
                                    @report.SubmissionDateText
                                </td>

                                <td>
                                    <span class="d-inline-block text-truncate mobile-truncate"
                                          style="max-width:200px"
                                          title="@report.ContextValue">
                                        @report.ContextValue
                                    </span>
                                </td>

                                <td>
                                    <span class="d-inline-block text-truncate mobile-truncate"
                                          style="max-width:160px"
                                          title="@report.ReportedBy">
                                        @report.ReportedBy
                                    </span>
                                </td>

                                <td>
                                    <span class="d-inline-block text-truncate text-muted small mobile-truncate"
                                          style="max-width:260px"
                                          title="@report.ShortDescription">
                                        @report.ShortDescription
                                    </span>
                                </td>

                                <td class="text-center">
                                    <a asp-page="/Admin/ReportDetail"
                                       asp-route-reportType="@report.ReportType"
                                       asp-route-detailId="@report.ProtectedReportId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="See detail">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

<div class="modal fade" id="exportExcelModal" tabindex="-1" aria-labelledby="exportExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="get" asp-page="/Admin/ReportList" id="exportExcelForm">
                <div class="modal-header border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-excel text-success fs-5"></i>
                        <h6 class="modal-title fw-bold mb-0" id="exportExcelModalLabel">Export Excel</h6>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="handler" value="Export" />
                    <input type="hidden" name="ReportType" value="@Model.ReportType" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small mb-1" for="exportFromDate">
                                From Date
                            </label>
                            <input id="exportFromDate"
                                   name="FromDate"
                                   value="@Model.FromDate"
                                   type="date"
                                   class="form-control form-control-sm" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small mb-1" for="exportToDate">
                                To Date
                            </label>
                            <input id="exportToDate"
                                   name="ToDate"
                                   value="@Model.ToDate"
                                   type="date"
                                   class="form-control form-control-sm" />
                        </div>

                        @if (Model.IsMachineType)
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold small mb-1" for="exportMachineId">
                                    Machine
                                </label>
                                <select id="exportMachineId"
                                        name="MachineId"
                                        class="form-select form-select-sm">
                                    <option value="">All Machines</option>
                                    @foreach (var machine in Model.MachineOptions)
                                    {
                                        <option value="@machine.Value" selected="@(machine.Value == Model.MachineId?.ToString())">
                                            @machine.Text
                                        </option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="col-12">
                            <label class="form-label fw-semibold small mb-1 d-block">
                                Status
                            </label>

                            <div class="d-flex flex-wrap align-items-center gap-3">
                                @foreach (var s in new[] { "open", "on progress", "close" })
                                {
                                    var exportLabelId = "export_status_" + s.Replace(" ", "");
                                    var labelText = s switch
                                    {
                                        "open" => "Open",
                                        "on progress" => "On Progress",
                                        "close" => "Close",
                                        _ => s
                                    };

                                    <div class="form-check mb-0">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="Status"
                                               value="@s"
                                               id="@exportLabelId"
                                               @(Model.IsStatusSelected(s) ? "checked" : "") />
                                        <label class="form-check-label small" for="@exportLabelId">
                                            @labelText
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-success btn-sm" id="exportExcelSubmitButton">
                        <i class="bi bi-download me-1"></i>
                        <span class="export-button-text">Export</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $('table.initDataTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                columnDefs: [
                    { orderable: false, targets: 5 }
                ],
                responsive: true,
                autoWidth: false,
                language: {
                    emptyTable: 'No Report Found.',
                    zeroRecords: 'No Report Found.'
                }
            });

            const exportModal = document.getElementById('exportExcelModal');
            const exportForm = document.getElementById('exportExcelForm');
            const exportButton = document.getElementById('exportExcelSubmitButton');
            const exportButtonText = exportButton?.querySelector('.export-button-text');

            function resetExportButton() {
                if (!exportButton || !exportButtonText) {
                    return;
                }

                exportButton.disabled = false;
                exportButtonText.textContent = 'Export';
            }

            if (exportForm && exportButton && exportButtonText) {
                exportForm.addEventListener('submit', function () {
                    exportButton.disabled = true;
                    exportButtonText.textContent = 'Exporting...';
                });
            }

            if (exportModal) {
                exportModal.addEventListener('show.bs.modal', resetExportButton);
                exportModal.addEventListener('hidden.bs.modal', resetExportButton);
            }

        });
    </script>
}

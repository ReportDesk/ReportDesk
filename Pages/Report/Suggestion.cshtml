@page
@model ReportSystem.Pages.Report.SuggestionModel
@{
    ViewData["Title"] = Model.PageHeading;
}

<div class="container-body">
    <div class="row mb-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h4 class="fw-bold mb-1">@Model.PageHeading</h4>
            <small class="text-muted">@Model.PageDescription</small>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="row">
            <div class="col-12 col-md-10 col-lg-8 mx-auto">
                <div class="alert alert-success">@Model.SuccessMessage</div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Title" class="form-label fw-semibold">Title</label>
                                <input asp-for="Title" class="form-control" placeholder="Enter report title" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Time</label>
                                <input type="text" class="form-control" value="@Model.CurrentTimeDisplay" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold">Name</label>
                                <input asp-for="Name" class="form-control" placeholder="Enter your name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Area" class="form-label fw-semibold">Area</label>
                                <input asp-for="Area" class="form-control" placeholder="Enter area" />
                                <span asp-validation-for="Area" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="6" placeholder="Write the report details"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Photo" class="form-label fw-semibold">Upload Photo</label>
                                <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                            </div>
                            <div class="col-12 d-grid">
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
